
import java.util.*;

class Hamiltonian {

    static int n;
    static int[][] graph;
    static int[] path;

    static boolean Solve(int pos) {
        if (pos == n) {
            if (graph[path[n - 1]][path[0]] == 1) {
                for (int i = 0; i < n; i++) {
                    System.out.print(path[i] + " ");
                }
                System.out.println(path[0]);
                return true;
            }
            return false;
        }

        for (int v = 1; v < n; v++) {
            if (graph[path[pos - 1]][v] == 1 && !isPresent(v, pos)) {
                path[pos] = v;

                if (Solve(pos + 1)) {
                    return true;
                }

                path[pos] = -1;
            }
        }

        return false;
    }

    static boolean isPresent(int v, int pos) {
        for (int i = 0; i < pos; i++) {
            if (path[i] == v) {
                return true;
            }
        }
        return false;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number of vertices: ");
        n = sc.nextInt();

        graph = new int[n][n];
        path = new int[n];

        System.out.println("Enter adjacency matrix:");
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                graph[i][j] = sc.nextInt();
            }
        }

        Arrays.fill(path, -1);
        path[0] = 0;

        if (!Solve(1)) {
            System.out.println("No Hamiltonian Cycle");
        }

        sc.close();
    }
}
