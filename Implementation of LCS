public class LCSAlgorithm {
    public static int[][] lcsLength(String m, String n) {
        int x = m.length();
        int y = n.length();

        int[][] dp = new int[x + 1][y + 1];

        for (int i = 1; i <= x; i++) {
            for (int j = 1; j <= y; j++) {
                if (m.charAt(i - 1) == n.charAt(j - 1)) {
                    dp[i][j] = dp[i - 1][j - 1] + 1;
                } else {
                    dp[i][j] = Math.max(dp[i - 1][j], dp[i][j - 1]);
                }
            }
        }

        return dp;
    }
    public static String buildLcs(String m, String n, int[][] dp) {
        int i = m.length();
        int j = n.length();

        StringBuilder result = new StringBuilder();

        while (i > 0 && j > 0) {
            if (m.charAt(i - 1) == n.charAt(j - 1)) {
                result.append(m.charAt(i - 1));
                i--;
                j--;
            } else if (dp[i - 1][j] >= dp[i][j - 1]) {
                i--;
            } else {
                j--;
            }
        }
        return result.reverse().toString();
    }

    public static void main(String[] args) {
        String m = "YASH";
        String n = "NAYAK";

        int[][] dp = lcsLength(m, n);
        int length = dp[m.length()][n.length()];
        String lcs = buildLcs(m, n, dp);

        System.out.println("Name: " + m);
        System.out.println("Surname: " + n);
        System.out.println("Length of LCS: " + length);
        System.out.println("LCS: " + lcs);
    }
}
